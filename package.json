{
  "name": "lms",
  "private": true,
  "description": "Learning Management System",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "infra"
  ],
  "scripts": {
    "build": "npm run build -w @lms/shared && npm run build -w @lms/api -w @lms/web",
    "dev:api": "npm run dev -w @lms/api",
    "dev:web": "npm run dev -w @lms/web",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "npm run db:migrate -w @lms/api",
    "db:seed": "npm run db:seed -w @lms/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build -w @lms/shared && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "synth": "npm run synth -w @lms/infra"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
